# ==============================================================================
# Environment Configuration Template (Safe for Git)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Google AI Studio Free Tier (Primary LLM: Gemini 1.5 Flash)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq Free Tier (Backup LLM fallback)
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL 16 Database URL (Local Docker or Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shopping_db

# Langfuse Observability (Optional Free Tier Cloud Tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# FastAPI Server Config
PORT=8000
ENVIRONMENT=development
